  "panels":[
    {"type":"stat","title":"Pricing status","description":"A reviewed KIP whole-node profile gates every published cost series.","id":1,"gridPos":{"h":4,"w":4,"x":0,"y":0},"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"Configured","color":"green"},"1":{"text":"Pricing not configured","color":"orange"}}}],"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":1}]}}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"1 - clamp_max(count(kip:cost:profile_info) or vector(0), 1)"}]},
