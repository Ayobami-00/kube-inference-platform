    {"type":"timeseries","title":"Model allocation, usage, shared, and unrequested cost","description":"OpenCost allocation is the bill-reconciling per-model view. Shared and unattributed series are request-based GPU cost classes; unrequested capacity is the node-rate residual after all GPU requests. These categories are reported separately and are not relabeled as idle.","id":7,"gridPos":{"h":8,"w":12,"x":0,"y":4},"fieldConfig":{"defaults":{"unit":"currencyUSD"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by(namespace,model_name) (kip:cost:inference_hourly_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\",cost_basis=\"allocation\"})","legendFormat":"allocated {{namespace}} / {{model_name}}"},{"refId":"B","expr":"sum by(namespace,model_name) (kip:cost:inference_hourly_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\",cost_basis=\"usage\"})","legendFormat":"usage {{namespace}} / {{model_name}}"},{"refId":"C","expr":"sum by(namespace) (kip:cost:shared_gpu_requested_hourly_usd{cluster=~\"$cluster\"})","legendFormat":"shared requested {{namespace}}"},{"refId":"D","expr":"sum by(namespace) (kip:cost:unattributed_gpu_requested_hourly_usd{cluster=~\"$cluster\"})","legendFormat":"unattributed requested {{namespace}}"},{"refId":"E","expr":"sum(kip:cost:gpu_unrequested_hourly_usd{cluster=~\"$cluster\"})","legendFormat":"unrequested capacity"}]},
    {"type":"timeseries","title":"Cost and serving efficiency","id":8,"gridPos":{"h":8,"w":12,"x":12,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(kip:cost:cluster_hourly_usd{cluster=~\"$cluster\"})","legendFormat":"USD/hour"},{"refId":"B","expr":"sum(kip:efficiency:tokens_per_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\"})","legendFormat":"tokens/USD"},{"refId":"C","expr":"avg(kip:gpu:runtime_utilization_ratio{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=~\"$deployment\",runtime=~\"$runtime\",model_profile=~\"$model_profile\",model_name=~\"$model_name\",worker_role=~\"$worker_role\",replica=~\"$replica\",pipeline_rank=~\"$pipeline_rank\",tensor_rank=~\"$tensor_rank\",node=~\"$node\",pod=~\"$pod\",gpu_uuid=~\"$gpu_uuid\"})","legendFormat":"GPU utilization"}]},
    {"type":"timeseries","title":"Energy efficiency (electricity included in node rate)","id":9,"gridPos":{"h":8,"w":12,"x":0,"y":12},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(kip:energy:runtime_watt_hours_per_request{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=~\"$deployment\",runtime=~\"$runtime\",model_profile=~\"$model_profile\",model_name=~\"$model_name\",worker_role=~\"$worker_role\",replica=~\"$replica\",pipeline_rank=~\"$pipeline_rank\",tensor_rank=~\"$tensor_rank\"})","legendFormat":"Wh/request"},{"refId":"B","expr":"sum(kip:energy:runtime_kilowatt_hours_per_million_tokens{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=~\"$deployment\",runtime=~\"$runtime\",model_profile=~\"$model_profile\",model_name=~\"$model_name\",worker_role=~\"$worker_role\",replica=~\"$replica\",pipeline_rank=~\"$pipeline_rank\",tensor_rank=~\"$tensor_rank\"})","legendFormat":"kWh/million output tokens"}]},
    {"type":"timeseries","title":"Per-model allocation and usage","id":10,"gridPos":{"h":8,"w":12,"x":12,"y":12},"fieldConfig":{"defaults":{"unit":"currencyUSD"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"kip:cost:inference_hourly_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\",cost_basis=\"allocation\"}","legendFormat":"{{model_name}} allocated USD/hour"},{"refId":"B","expr":"kip:cost:inference_hourly_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\",cost_basis=\"usage\"}","legendFormat":"{{model_name}} usage USD/hour"}]},
    {"type":"timeseries","title":"USD per million tokens","description":"Allocation-basis prompt, generation, and blended token economics from OpenCost inference tracking.","id":11,"gridPos":{"h":8,"w":12,"x":0,"y":20},"fieldConfig":{"defaults":{"unit":"currencyUSD"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"kip:cost:per_million_tokens_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\",cost_basis=\"allocation\",phase=\"prompt\"}","legendFormat":"{{model_name}} input"},{"refId":"B","expr":"kip:cost:per_million_tokens_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\",cost_basis=\"allocation\",phase=\"generation\"}","legendFormat":"{{model_name}} output"},{"refId":"C","expr":"kip:cost:per_million_tokens_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\",cost_basis=\"allocation\",phase=\"\"}","legendFormat":"{{model_name}} blended"}]},
    {"type":"timeseries","title":"Allocated and usage cost per request","description":"Allocated cost includes reconciled idle allocation; usage cost reflects active resource consumption. Cache savings remains a separate ratio.","id":12,"gridPos":{"h":8,"w":12,"x":12,"y":20},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"kip:cost:per_request_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\",cost_basis=\"allocation\"}","legendFormat":"{{model_name}} allocated USD/request"},{"refId":"B","expr":"kip:cost:per_request_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\",cost_basis=\"usage\"}","legendFormat":"{{model_name}} usage USD/request"},{"refId":"C","expr":"kip:cost:cache_savings_ratio{cluster=~\"$cluster\",namespace=~\"$namespace\",model_name=~\"$model_name\"}","legendFormat":"{{model_name}} cache savings ratio"}]},
    {"type":"timeseries","title":"Runtime GPU-request cost by role and rank","description":"Requested whole-GPU attribution by deployment, distributed worker role, replica, pipeline rank, and tensor rank. OpenCost allocation above remains the bill-reconciling model view.","id":13,"gridPos":{"h":8,"w":12,"x":0,"y":28},"fieldConfig":{"defaults":{"unit":"currencyUSD"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by(deployment,runtime,model_profile,model_name,worker_role,replica,pipeline_rank,tensor_rank) (kip:cost:runtime_gpu_requested_hourly_usd{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=~\"$deployment\",runtime=~\"$runtime\",model_profile=~\"$model_profile\",model_name=~\"$model_name\",worker_role=~\"$worker_role\",replica=~\"$replica\",pipeline_rank=~\"$pipeline_rank\",tensor_rank=~\"$tensor_rank\"})","legendFormat":"{{deployment}} / {{worker_role}} r{{replica}} p{{pipeline_rank}} t{{tensor_rank}}"}]},
