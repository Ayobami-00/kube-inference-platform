{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kube-inference-platform.local/schemas/cost-profile-v1.json",
  "title": "Kube Inference Platform whole-node cost profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "currency",
    "nodeHourlyRateUsd",
    "provider",
    "machineType",
    "region",
    "source",
    "effectiveFrom",
    "physicalGpuCount",
    "powerIncludedInRate"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "currency": { "const": "USD" },
    "nodeHourlyRateUsd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1000000
    },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "machineType": { "type": "string", "minLength": 1, "maxLength": 128 },
    "region": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^https://[^/@?#\\s]+(/[^?#\\s]*)?$"
    },
    "sourceType": {
      "enum": ["public-listing", "user-confirmed-billing"]
    },
    "effectiveFrom": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "physicalGpuCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "powerIncludedInRate": { "const": true }
  }
}
